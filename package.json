{
  "name": "chainmed",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend",
    "blockchain"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "node backend/dist/src/server.js",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "vitest run",
    "test:contract": "npm test -w blockchain",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "chain": "npm run node -w blockchain",
    "deploy": "npm run deploy -w blockchain",
    "worker": "npm run worker -w backend",
    "setup:env": "node scripts/setup-env.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "measure": "node --import tsx tests/performance/measure.ts",
    "format": "prettier --write frontend/src backend/src backend/prisma/seed.ts blockchain tests scripts *.ts *.json *.yml"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.10",
    "supertest": "^7.1.1",
    "typescript": "~5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22 <23 || >=24 <25"
  },
  "type": "module",
  "overrides": {
    "effect": "$effect",
    "deepmerge-ts": "$deepmerge-ts"
  }
}
