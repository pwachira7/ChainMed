{
  "name": "@chainmed/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "worker": "tsx src/workers/main.ts",
    "db:generate": "node ../scripts/prisma.mjs generate",
    "db:migrate": "node ../scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "tamper": "tsx src/utils/tamper.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ethers": "^6.14.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/pdfkit": "^0.13.8",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.0",
    "tsx": "^4.19.3"
  }
}
